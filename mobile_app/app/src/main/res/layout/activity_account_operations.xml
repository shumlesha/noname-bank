<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accountOperationsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvAccountNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Номер счета"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Баланс"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvAccountNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Сумма"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/tvBalance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnDeposit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Пополнить"
        android:backgroundTint="@color/greenPrimary"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/etAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnWithdraw"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btnWithdraw"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Снять"
        android:backgroundTint="@color/greenPrimary"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/etAmount"
        app:layout_constraintStart_toEndOf="@id/btnDeposit"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"/>

    <Button
        android:id="@+id/btnTransferOwn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Перевод между своими счетами"
        android:backgroundTint="@color/greenDark"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btnDeposit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnTransferOther"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Перевод на счет другого клиента"
        android:backgroundTint="@color/greenDark"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btnTransferOwn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etTargetCurrency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Целевая валюта (например, USD)"
        app:layout_constraintTop_toBottomOf="@id/btnTransferOther"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnConvert"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Конвертировать"
        android:backgroundTint="@color/greenPrimary"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/etTargetCurrency"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
